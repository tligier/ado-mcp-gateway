# Public HTTPS base URL of this gateway (no trailing slash). http://localhost:PORT is OK for dev.
PUBLIC_URL=http://localhost:3000
PORT=3000
# Set to 1 when behind Front Door / App Service / a reverse proxy
TRUST_PROXY=0

# Entra app registration (web platform, redirect URI = ${PUBLIC_URL}/oauth/callback)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Default: Azure DevOps user_impersonation (delegated)
# ENTRA_SCOPES=499b84ac-1321-427f-aa17-267ca6975798/user_impersonation offline_access openid profile

ADO_ORG=myorg
# Guardrails (comma separated; empty projects/types = unrestricted)
ADO_ALLOWED_PROJECTS=MyProject,AnotherProject
ADO_ALLOWED_WORK_ITEM_TYPES=Bug,User Story,Task
ADO_ALLOWED_OPERATIONS=read,create,update

# Optional: persist dynamically-registered MCP clients across restarts
# CLIENT_STORE_PATH=./data/clients.json
